# Variables de entorno en Vercel (Project Settings -> Environment Variables)
# Clave para entrar a /agenda (elige una propia; sin ella el panel no deja entrar en producción)
ADMIN_PASSWORD=
# Cualquier texto largo al azar (firma las sesiones del panel)
ADMIN_SECRET=
# Base de datos de reservas: en Vercel -> Storage -> Marketplace -> Upstash Redis -> Connect Project.
# Eso crea solo KV_REST_API_URL y KV_REST_API_TOKEN.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# En local (npm run dev) no hace falta nada: usa una clave de prueba y guarda en .data/store.json
